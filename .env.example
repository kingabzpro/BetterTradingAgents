# BetterTradingAgents configuration.
# Copy to .env and override only what you need (or run scripts/setup_wizard.py).
# Every setting is optional; without an LLM key the app runs in clearly
# labeled mock mode on live market data. Defaults live in app/config.py.

# ---- LLM: any OpenAI-compatible endpoint (OpenAI, Z.AI, DeepSeek, Qwen,
# OpenRouter, vLLM, llama.cpp...). Pair a cheap fast model with the
# researchers and a stronger one with the manager.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90
# Optional provider-specific reasoning effort (e.g. "none" or "low" for GLM)
LLM_REASONING_EFFORT=
# Cost estimate override, USD per 1M input/output tokens, applied to every
# role (custom/proxied pricing). 0 = use the dated list-price table in app/cost.py
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
# Optional per-role overrides (each falls back to the LLM_* values above):
# analysts = the 5 researchers, debate = bull/bear, manager = the final call.
# LLM_MODEL_MANAGER=
# LLM_BASE_URL_MANAGER=
# LLM_API_KEY_MANAGER=
# LLM_MODEL_ANALYSTS=
# LLM_BASE_URL_ANALYSTS=
# LLM_API_KEY_ANALYSTS=
# LLM_MODEL_DEBATE=
# LLM_BASE_URL_DEBATE=
# LLM_API_KEY_DEBATE=

# ---- Market-data providers (all optional; each has a built-in fallback)
# Finnhub: company profile, fundamentals, company news - https://finnhub.io
FINNHUB_API_KEY=
# Olostep: news web search + article scraping fallback - https://olostep.com
OLOSTEP_API_KEY=
# Nixtla TimeGPT: 5-day time-series forecast - https://nixtla.io
NIXTLA_API_KEY=

# ---- Analysis
# Maximum tickers accepted in one analysis
MAX_TICKERS=5
# 1 = single debate round; >= 2 adds one bull/bear rebuttal exchange (capped at 3)
DEBATE_ROUNDS=2
# 1 = stream agent tokens to the UI live (off by default: the stream is
# mostly the final JSON and reads as noise next to the result card)
STREAM_REASONING=0

# ---- Demo portfolio and storage
STARTING_CASH=100000
DEFAULT_POSITION_SIZE=10000
DB_PATH=portfolio.db

# ---- Risk gate: fractions of total equity applied to every BUY
MAX_POSITION_PCT=0.10
MAX_INVESTED_PCT=0.60
MIN_CASH_PCT=0.10

# ---- Decision memory and calibration
# Days a past call is held before its realized-return grade is final
MEMORY_HORIZON_DAYS=21
# 1 = ask the LLM for reflection lessons instead of deterministic sentences
MEMORY_REFLECT_WITH_LLM=0
# A bucket with fewer mature graded decisions than this reports
# "Track record unavailable" instead of an unsupported rate
CALIBRATION_MIN_OBSERVATIONS=30

# ---- Backtests
# Snapshot cache location; BACKTEST_OFFLINE=1 makes cache misses fail
# instead of hitting the network (proves warm re-runs are truly offline)
# BACKTEST_CACHE=docs/backtests/cache.db
# BACKTEST_OFFLINE=0
