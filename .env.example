# BetterTradingAgents configuration.
# Copy to .env and override only what you need (or run scripts/setup_wizard.py).
# Every setting is optional; without an LLM key the app runs in clearly
# labeled mock mode on live market data. Defaults live in app/config.py.
# Everything here is also editable in the app's Settings page (/settings):
# values saved there override .env, apply without a restart, and API keys
# are stored in the OS keychain, not in .env or the database.

# ---- Terminal output
# 0 (default): a quiet terminal - warnings and errors only, no request log.
# 1: the full INFO trail plus every uvicorn request line.
#TERMINAL_LOGGING=0

# ---- Server
# Port for `uv run app` (default 8000). If it is already taken, the app
# automatically serves on the next free port and says so in the banner.
#APP_PORT=8000

# ---- LLM: any OpenAI-compatible endpoint (OpenAI, Z.AI, DeepSeek, Qwen,
# OpenRouter, vLLM, llama.cpp...). Pair a cheap fast model with the
# researchers and a stronger one with the manager.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# 0.0 = steadiest sampling; the phase-4 panel measured 2/20 run-to-run
# decision flips at 0.0 vs 6/20 at 0.2 (and ~4.6% cheaper)
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=90
# Cap on a single response's tokens (0 = provider default) and smart retries
# per call after rate limits / server errors / malformed output (0 = fail fast)
MAX_TOKENS=0
LLM_MAX_RETRIES=2
# Optional provider-specific reasoning effort (e.g. "none" or "low" for GLM)
LLM_REASONING_EFFORT=
# Cost estimate override, USD per 1M input/output tokens, applied to every
# role (custom/proxied pricing). 0 = use the dated list-price table in app/cost.py
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
# Optional per-role overrides (each falls back to the LLM_* values above):
# analysts = the 5 researchers, debate = bull/bear, manager = the final call.
# LLM_MODEL_MANAGER=
# LLM_REASONING_EFFORT_MANAGER=high
# LLM_BASE_URL_MANAGER=
# LLM_API_KEY_MANAGER=
# LLM_MODEL_ANALYSTS=
# LLM_BASE_URL_ANALYSTS=
# LLM_API_KEY_ANALYSTS=
# LLM_MODEL_DEBATE=
# LLM_BASE_URL_DEBATE=
# LLM_API_KEY_DEBATE=
# Optional per-agent overrides (each falls back to its role, then LLM_* above);
# the six researchers plus the debate judge.
# LLM_MODEL_MARKET=
# LLM_BASE_URL_MARKET=
# LLM_API_KEY_MARKET=
# LLM_MODEL_TECHNICAL=
# LLM_BASE_URL_TECHNICAL=
# LLM_API_KEY_TECHNICAL=
# LLM_MODEL_FUNDAMENTAL=
# LLM_BASE_URL_FUNDAMENTAL=
# LLM_API_KEY_FUNDAMENTAL=
# LLM_MODEL_NEWS=
# LLM_BASE_URL_NEWS=
# LLM_API_KEY_NEWS=
# LLM_MODEL_SENTIMENT=
# LLM_BASE_URL_SENTIMENT=
# LLM_API_KEY_SENTIMENT=
# LLM_MODEL_FORECAST=
# LLM_BASE_URL_FORECAST=
# LLM_API_KEY_FORECAST=
# LLM_MODEL_JUDGE=
# LLM_BASE_URL_JUDGE=
# LLM_API_KEY_JUDGE=

# ---- Market-data providers (all optional; each has a built-in fallback)
# Finnhub: company profile, fundamentals, company news - https://finnhub.io
FINNHUB_API_KEY=
# Olostep: news web search + article scraping fallback - https://olostep.com
OLOSTEP_API_KEY=
# Tavily: news web search, first fallback behind Olostep - https://tavily.com
TAVILY_API_KEY=
# Firecrawl: news web search, second fallback behind Olostep - https://firecrawl.dev
FIRECRAWL_API_KEY=
# Bako: hosted TimesFM price predictions, the hosted forecast link - https://bako.co
BAKO_API_KEY=

# ---- Analysis
# Maximum tickers accepted in one analysis
MAX_TICKERS=5
# 1 = single debate round; >= 2 adds one bull/bear rebuttal exchange (capped at 3)
DEBATE_ROUNDS=2
# 1 = stream agent tokens to the UI live (off by default: the stream is
# mostly the final JSON and reads as noise next to the result card)
STREAM_REASONING=0
# Wall-clock deadline for one analysis run (minutes); a hung provider call
# fails the run instead of leaving it "running" forever
RUN_TIMEOUT_MINUTES=30

# ---- Demo portfolio and storage
STARTING_CASH=100000
DEFAULT_POSITION_SIZE=10000
DB_PATH=portfolio.db

# ---- Risk gate: fractions of total equity applied to every BUY
MAX_POSITION_PCT=0.10
MAX_INVESTED_PCT=0.60
MIN_CASH_PCT=0.10
# Drawdown brake: BUYs halt once open positions' unrealized loss exceeds this
# share of the cash-plus-cost basis behind them
MAX_DRAWDOWN_PCT=0.15
# Open-position count cap: a BUY of a new ticker halts at this many positions
MAX_POSITIONS=10
# Correlated-group cap: a BUY whose exposure, combined with holdings whose
# daily returns correlate at/above 0.7, would push the group past this share
# of equity raises a warning (warning-only; the caps above still block)
MAX_CORRELATED_PCT=0.25

# ---- Risk overlay: deterministic exits between agent runs (off by default)
OVERLAY_ENABLED=0
# Exit a position this far below its entry price / its own peak
OVERLAY_STOP_LOSS_PCT=0.12
OVERLAY_TRAILING_STOP_PCT=0.15
# After a stop exit, autopilot will not re-enter that ticker for this many days
OVERLAY_COOLDOWN_DAYS=5

# Risk-regime gate: a deterministic SPY/VIX read scales NEW BUY risk
# (risk_on 1.0x, neutral 0.75x, risk_off blocks entries once persistent,
# plus a fast 3-session shock block). Off by default; enable on the
# Settings page when you want sizing to follow the regime.
RISK_REGIME_ENABLED=0

# ---- Decision memory and calibration
# Days a past call is held before its realized-return grade is final
MEMORY_HORIZON_DAYS=21
# Minutes between settle passes that grade every decision whose horizon
# window closed, even if its ticker is never analyzed again (minimum 15)
MEMORY_SETTLE_INTERVAL_MINUTES=60
# 1 = ask the LLM for reflection lessons instead of deterministic sentences
MEMORY_REFLECT_WITH_LLM=0
# A bucket with fewer mature graded decisions than this reports
# "Track record unavailable" instead of an unsupported rate
CALIBRATION_MIN_OBSERVATIONS=30
# 1 = scale proposed BUY risk by the manager's reliability curve (observed vs
# predicted per band, clamped 0.5-1.0, never inflating). Live runs only
CALIBRATION_SIZING=0

# ---- Backtests
# Snapshot cache location; BACKTEST_OFFLINE=1 makes cache misses fail
# instead of hitting the network (proves warm re-runs are truly offline)
# BACKTEST_CACHE=backtests/cache.db
# BACKTEST_OFFLINE=0

# ---- Alpaca paper trading (P2.1, optional; feature is dormant without keys)
# Paper keys from the paper section of the Alpaca dashboard. Both common
# spellings are accepted (ALPACA_API_KEY / ALPACA_SECRET_KEY also work).
# The adapter is paper-only: no configuration can reach the live broker.
#ALPACA_API_KEY_ID=
#ALPACA_API_SECRET_KEY=
# Kill switch: 0 = read-only (account reads work, order submissions refused)
#ALPACA_TRADING_ENABLED=0
# Per-order notional cap in USD
#ALPACA_MAX_ORDER_USD=10000
# Non-rejected submissions per UTC day
#ALPACA_MAX_ORDERS_PER_DAY=20
# Research older than this many hours cannot be traded
#ALPACA_MAX_DECISION_AGE_HOURS=72
# Minutes between reconciliation sweeps (minimum 5): they refresh non-terminal
# orders by client id and flag broker orders this app did not place (a sweep
# also runs once at startup, before autopilot may submit)
#BROKER_SYNC_INTERVAL_MINUTES=15

# ---- Automated paper-trading sessions (autopilot, optional)
# A background loop scans the market for candidates, adds held tickers, runs
# the full agent pipeline, and submits the risk-gated trades through the same
# guarded broker path (kill switch, caps, and freshness checks still apply).
# Sessions never trade mock decisions; scheduled ones only run while the
# market is open. The on/off toggle lives in the DB (Portfolio page) and is
# seeded from AUTOMATION_ENABLED on first boot.
#AUTOMATION_ENABLED=0
# Minutes between sessions (minimum 15)
#AUTOMATION_INTERVAL_MINUTES=240
# Market-scan candidates per session (the "I Am Feeling Lucky" screen)
#AUTOMATION_CANDIDATES=3
# Names analyzed by recent sessions rest this many days so the shortlist
# rotates instead of repeating; 0 disables (held positions are always checked)
#AUTOMATION_CANDIDATE_COOLDOWN_DAYS=3
# BUYs need at least this final (risk-gated) confidence; SELLs always exit
#AUTOMATION_MIN_CONFIDENCE=0.65
#AUTOMATION_OUTLOOK=short_term
#AUTOMATION_DEPTH=fast
# 1 = a SELL decision exits the held position; 0 = BUYs only
#AUTOMATION_ALLOW_SELLS=1
# A session longer than this many minutes is cancelled and recorded as failed
#AUTOMATION_SESSION_TIMEOUT_MINUTES=40
# Portfolio budget: BUYs stop once autopilot's net deployed notional (its
# non-rejected buys minus its filled sells) passes this share of equity, and
# never take cash below the floor share (1.0 / 0.0 = only the global risk gate)
#AUTOMATION_MAX_DEPLOYED_PCT=1.0
#AUTOMATION_CASH_FLOOR_PCT=0.0
# The bear-market brake is always on: while SPY sits below its 200-day
# average, sessions still research and exit, but BUYs are recorded as braked
# One plain-text POST per finished autopilot session (empty = off)
#WEBHOOK_URL=
