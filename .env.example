# LLM - any OpenAI-compatible endpoint (OpenAI, OpenRouter, DeepSeek, Qwen, GLM, vLLM, llama.cpp...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional tuning
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90
# Optional provider-specific reasoning effort (e.g. "none" or "low" for GLM models)
LLM_REASONING_EFFORT=

# Data providers (all optional - the app falls back gracefully)
# Finnhub: company profile, fundamentals, company news - https://finnhub.io
FINNHUB_API_KEY=
# Olostep: news web search + article scraping fallback - https://olostep.com
OLOSTEP_API_KEY=
# Nixtla TimeGPT: 5-day time-series forecast - https://nixtla.io
NIXTLA_API_KEY=

# Analysis
MAX_TICKERS=5
# 1 = single debate round; >= 2 adds one bull/bear rebuttal exchange (capped at 3)
DEBATE_ROUNDS=2

# Demo portfolio
STARTING_CASH=100000
DEFAULT_POSITION_SIZE=10000
DB_PATH=portfolio.db

# Risk gate - fractions of total equity applied to every BUY
MAX_POSITION_PCT=0.10
MAX_INVESTED_PCT=0.60
MIN_CASH_PCT=0.10

# Decision memory - grade past calls against realized returns + SPY alpha
MEMORY_HORIZON_DAYS=21
MEMORY_REFLECT_WITH_LLM=0
